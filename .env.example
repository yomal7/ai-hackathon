# Rakshaka — copy this file to .env and fill in your keys.
# Never commit .env (it is in .gitignore).

# Jev (TypeSafe System One) — System 1, fast risk answers
TYPESAFE_API_KEY=

# Gemini — System 2, by llm() text and reasoning
GEMINI_API_KEY=

# LLM model used by by llm() (litellm format)
BYLLM_DEFAULT_MODEL=gemini/gemini-3.5-flash-lite

# Jev call timeout in milliseconds (code fallback is used after this)
JEV_TIMEOUT_MS=800

# LLM (Gemini) time limit in milliseconds (fixed text is used after this)
LLM_TIMEOUT_MS=6000
