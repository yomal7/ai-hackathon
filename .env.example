# Rakshaka — copy this file to .env and fill in your keys. Never commit .env.
# On JacHammer, add the same names as environment variables.

# System 1 - Jev (TypeSafe System One model): fast risk answers
TYPESAFE_API_KEY=

# System 2 - LLM for `by llm()`: questions, cards, patterns, debrief
LLM_MODEL=gemini/gemini-3.5-flash-lite
GEMINI_API_KEY=
# OPENAI_API_KEY=            # only if LLM_MODEL is an OpenAI model

# Time limits in milliseconds (the code fallback is used after this)
JEV_TIMEOUT_MS=800
LLM_TIMEOUT_MS=6000

# Use LiteLLM's built-in price list instead of downloading it at start-up (slow networks time out)
LITELLM_LOCAL_MODEL_COST_MAP=True
